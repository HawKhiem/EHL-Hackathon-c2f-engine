# ============================================================
#  Copy to .env and fill in.  setup.sh does this for you.
#  NEVER commit .env — it is gitignored.
# ============================================================

# ---------- Supabase ----------
# setup.sh fills these in from `supabase status` after starting the local stack.
#
# Two keys, two privilege levels:
#   PUBLISHABLE (sb_publishable_...) - safe in the browser. Hits the DB as the
#       `anon` role, so Row Level Security applies. Public by design.
#   SECRET      (sb_secret_...)      - backend only. Hits the DB as
#       `service_role`, which BYPASSES RLS. Never send this to a client.
#
# These replace the legacy `anon` / `service_role` JWT keys, which Supabase is
# deprecating by the end of 2026. The CLI still emits the old ones; do not use
# them in new code.
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---------- LLM ----------
# anthropic (default) | openai
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# Optional — only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=

# Override the model per provider if you want (see backend/app/config.py
# for the defaults). Leave blank to use the provider default.
LLM_MODEL=

# Claude Opus 5's safety classifiers can decline a request (HTTP 200 with
# stop_reason="refusal"). With this on, the API re-runs the request on a
# fallback model server-side. Requires the beta to be enabled on your key —
# the backend detects a rejection and retries without it, so `true` is safe.
LLM_ENABLE_REFUSAL_FALLBACK=true

# Rate limit for /llm/* per client IP. These endpoints cost money per call, so
# an open one on a public URL will drain your credits. In-memory and
# per-process - if you run multiple workers, move it to Redis.
LLM_RATE_LIMIT_TIMES=20
LLM_RATE_LIMIT_SECONDS=60

# ---------- Backend ----------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Frontend ----------
# Vite only exposes vars prefixed with VITE_ to browser code.
# Anything secret must stay on the backend.
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------- Claim to Fame engine (c2f/) ----------
# TEAM_API_KEY      QuantCo team key (required)
# Model provider is auto-picked: ANTHROPIC_API_KEY -> Claude, else OPENAI_API_KEY -> OpenAI.
# C2F_MODEL         full-pass model (default claude-opus-5 / gpt-5)
# C2F_FAST_MODEL    fast first-pass model (default claude-sonnet-5 / gpt-5-mini)
# C2F_REASONING     OpenAI reasoning_effort for gpt-5 models (default low)
TEAM_API_KEY=
C2F_BASE_URL=https://c2f.public.quantco.cloud
