# ============================================================
#  Copy to .env and fill in.
#  NEVER commit .env — it is gitignored.
# ============================================================

# ---------- Claim to Fame engine (c2f/) ----------
# TEAM_API_KEY      QuantCo team key (required)
# This team uses OpenAI only — leave ANTHROPIC_API_KEY unset so llm.py picks OpenAI.
# C2F_MODEL         full-pass model (default gpt-5.6-sol)
# C2F_FAST_MODEL    fast first-pass model (default gpt-5.6-terra)
# C2F_DIGEST_MODEL  policy-digest model (default gpt-5.6-luna)
# C2F_REASONING     OpenAI reasoning_effort for the full pass (default low)
TEAM_API_KEY=
C2F_BASE_URL=https://c2f.public.quantco.cloud

OPENAI_API_KEY=
