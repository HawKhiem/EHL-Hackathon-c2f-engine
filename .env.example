# ============================================================
#  Copy to .env and fill in.
#  NEVER commit .env — it is gitignored.
# ============================================================

# ---------- Claim to Fame engine (c2f/) ----------
# TEAM_API_KEY      QuantCo team key (required)
# Model provider is auto-picked: ANTHROPIC_API_KEY -> Claude, else OPENAI_API_KEY -> OpenAI.
# C2F_MODEL         full-pass model (default claude-opus-5 / gpt-5)
# C2F_FAST_MODEL    fast first-pass model (default claude-sonnet-5 / gpt-5-mini)
# C2F_REASONING     OpenAI reasoning_effort for gpt-5 models (default low)
TEAM_API_KEY=
C2F_BASE_URL=https://c2f.public.quantco.cloud

ANTHROPIC_API_KEY=
# Optional — used only if ANTHROPIC_API_KEY is unset
OPENAI_API_KEY=
