# ============================================================
#  Copy to .env and fill in.
#  NEVER commit .env — it is gitignored.
# ============================================================

# ---------- Claim to Fame engine (c2f/) ----------
# TEAM_API_KEY      QuantCo team key (required)
# This team uses OpenAI only — leave ANTHROPIC_API_KEY unset so llm.py picks OpenAI.
# C2F_MODEL         full-pass model (default gpt-5)
# C2F_FAST_MODEL    fast first-pass model (default gpt-5-mini)
# C2F_REASONING     OpenAI reasoning_effort for gpt-5 models (default low)
TEAM_API_KEY=
C2F_BASE_URL=https://c2f.public.quantco.cloud

OPENAI_API_KEY=
