#!/usr/bin/env bash
# Refuse to commit a change to the pricing algorithm unless the backtest was re-run AFTER the change.
# Algorithm files: anything that changes what we submit. Install once with:  make hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
ALGO_RE='^c2f/(price|llm|ensemble|extract|run|calibrate)\.py$'
changed=$(git diff --cached --name-only | grep -E "$ALGO_RE" || true)
[[ -z "$changed" ]] && exit 0
summary=runs/backtest/summary.json
if [[ ! -f "$summary" ]]; then
  echo "pre-commit: you changed the algorithm ($changed) but runs/backtest/summary.json does not exist."
  echo "            run:  make backtest     (then git add runs/backtest && commit again)"; exit 1
fi
for f in $changed; do
  if [[ "$f" -nt "$summary" ]]; then
    echo "pre-commit: $f is newer than $summary - the backtest predates your change."
    echo "            run:  make backtest     (then git add runs/backtest && commit again)"; exit 1
  fi
done
if ! git diff --cached --name-only | grep -q '^runs/backtest/summary.json$'; then
  echo "pre-commit: stage the backtest result too:  git add runs/backtest"; exit 1
fi
if [[ "${ALLOW_BACKTEST_FAIL:-0}" != "1" ]]; then
  python3 - "$summary" <<'PY' || exit 1
import json, sys
s = json.load(open(sys.argv[1])); t = s.get("totals", {})
if not t.get("success"):
    print(f"pre-commit: backtest verdict is NOT GOOD ENOUGH - expected replay wins {t.get('wins_exp')}/{t.get('n_games')} old games (need a majority).")
    print("            improve the change, or override knowingly with:  ALLOW_BACKTEST_FAIL=1 git commit ...")
    sys.exit(1)
PY
fi
echo "pre-commit: backtest summary is fresh ($(python3 -c "import json;s=json.load(open('$summary'));t=s.get('totals',{});print('SUCCESS' if t.get('success') else 'OVERRIDDEN','- expected wins',t.get('wins_exp'),'/',t.get('n_games'),'exp net',round(t.get('expected',0)))"))"
