# Keeps formatting consistent across VS Code, JetBrains, Vim and friends.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{md,markdown}]
# Trailing whitespace is a hard line break in Markdown.
trim_trailing_whitespace = false

[Justfile]
indent_size = 4

[*.{sql,toml}]
indent_size = 2

[Makefile]
indent_style = tab
